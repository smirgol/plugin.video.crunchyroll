# Copy to .env (gitignored) and adjust. Plain KEY=VALUE lines, no quotes needed.

# Required: directory holding one Kodi data dir per box (<dir>/<version>).
# Contains auth tokens and the Widevine CDM - keep it outside the repo.
KODI_BOXES_DATA=/path/to/kodi-boxes-data

# Optional: addon source to mount (default: repository root), e.g. a git worktree of another branch.
ADDON_SRC=
